# TrendBot - Configuracao de Ambiente
# Copie este arquivo para .env e preencha os valores

# Email para envio do Daily Digest (Gmail com senha de app)
EMAIL_REMETENTE=seu@gmail.com
EMAIL_SENHA=sua_senha_de_app
EMAIL_DESTINO=destino@gmail.com

# Ativos monitorados (separados por virgula)
MOEDAS_ALVO=bitcoin,ethereum,solana,cardano

# Periodo de dados historicos em dias
DIAS_HISTORICO=365

# Horario da execucao automatica local (formato HH:MM)
HORARIO_RODADA=10:00
