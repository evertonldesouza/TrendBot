# TrendBot - Configuracao de Ambiente
# Copie este arquivo para .env e preencha os valores.
# O projeto NAO envia e-mail: nao ha segredo de SMTP em nenhum lugar.

# Ativos monitorados (separados por virgula)
MOEDAS_ALVO=bitcoin,ethereum,solana,cardano

# Periodo de dados historicos em dias
DIAS_HISTORICO=365

# O que voce tem hoje: SIMBOLO:valor_em_USD, separados por virgula.
# Aceita nome ("bitcoin") ou simbolo ("BTC"), tanto faz.
# Sem isso, a recomendacao parte de 100% caixa: diz como aplicar um dinheiro
# parado, nunca como rebalancear o que voce ja tem.
CARTEIRA_ATUAL=BTC:12000,ETH:5000,USD:3000

# Aporte mensal em USD (opcional)
APORTE_MENSAL=0
